dialog("a");
var i = 0;

function init() {
	debug("init called");
}

function draw() {
	fillCircle(i, 100, 10, GREEN);
}



function loop() {
	draw();
	delay(100);
	i = i + 20;
}



/* VARS
i	Int	0	4
