

init{
	int playersCount = 4;
    int playerBalance[7];
	str[6] playerNames[7]; 

	for(int i = 1; i <= 6; i = i + 1) {
		playerBalance[i] = loadInt(1500 + i * 5, 2500);
		
	}
	
	playerNames[0] = "[BANK]";
	

	loadStr(1540 + 1 * 8, &playerNames + 1 * 7, "P1", 6); 
	loadStr(1540 + 2 * 8, &playerNames + 2 * 7, "P2", 6); 
	loadStr(1540 + 3 * 8, &playerNames + 3 * 7, "P3", 6); 
	loadStr(1540 + 4 * 8, &playerNames + 4 * 7, "P4", 6); 
	loadStr(1540 + 5 * 8, &playerNames + 5 * 7, "P5", 6); 
	loadStr(1540 + 6 * 8, &playerNames + 6 * 7, "P6", 6); 

	//saveStr(1540 + 3 * 8, "TIGRAN", 6);

}




int sourceAccount = -1;
int targetAccount = -1; 

draw{
	dialog("MONETRIX BANK"); 
	

	for(int y = 0; y <= 1; y = y + 1) {
		for(int x = 0; x <= 2; x = x + 1) {
			int i = x + y * 3 + 1;
			if (i <= playersCount) {
				cursor(12 + x * 155, 40 + y * 80, 3);
				print(i, GRAY);
				print(":", GRAY);
				print(playerNames[i], WHITE); 

				byte color = YELLOW;
				if (playerBalance[i] < 0) {
					color = RED;
				}
				if (playerBalance[i] > 200) {
					color = GREEN;
				}

				cursor(12 + x * 155, 70 + y * 80, 4);
				print("$", color);
				print(playerBalance[i], color);
			}
			
		}
	}

	// drawRoundBox(10,190,460,120,20, GRAY);

	cursor(20, 290, 2);
	print("SELECT PLAYER 1-", CYAN);
	print(playersCount, CYAN);

	cursor(460, 290, 2);
	printRight("0 = BANK", CYAN);
}


call draw;

loop{
    char key = getKey();
	int selected = getNumericKey();

	if (key == 'C') {
		int pc = confirmNumber("PLAYESR COUNT", "2 - 6", 2, 6);
		if (pc >= 0) {playersCount = pc;}
		call draw;
	}

	if (selected >= 0 && selected <= playersCount) {
		sourceAccount = selected;
		load("target");
	}

    delay(1);
}