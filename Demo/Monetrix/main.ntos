init{
    int playerBalance[6];
	str[6] playerName[6];

	playerBalance[0] = 2500;
    playerBalance[1] = -500;
    playerBalance[2] = -200;
    playerBalance[3] = -0;
    playerBalance[4] = 200;
    playerBalance[5] = 15;
	
	playerName[0] = "TIGRAN";
	playerName[1] = "P2";
	playerName[2] = "AMELIA";
	playerName[3] = "P4";
	playerName[4] = "P5";
	playerName[5] = "P6";

}



dialog("MONETRIX BANK"); 



for(int y = 0; y <= 1; y = y + 1) {
	for(int x = 0; x <= 2; x = x + 1) {
		int i = x + y * 3;
		cursor(12 + x * 155, 40 + y * 80, 3);
		print(i, GRAY);
		print(":", GRAY);
		print(playerName[i], WHITE); 

		byte color = YELLOW;
		if (playerBalance[i] < 0) {
			color = RED;
		}
		if (playerBalance[i] > 200) {
			color = GREEN;
		}

		cursor(12 + x * 155, 70 + y * 80, 4);
		print("$", color);
		print(playerBalance[i], color);
	}
}

drawRoundBox(10,190,460,120,20, GRAY);

cursor(240, 200, 2);
printCentered("SELECT PLAYER 1-6", CYAN);

loop{


    delay(100);
}