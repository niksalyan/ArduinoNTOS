init{
	int px = 240;
	int py = 160;
}

call update;

update{
    cls(100, 100, 2);
	cursor();
    print("HELLO", GREEN);
    fillCircle(px, py, 20, YELLOW);
}


loop {
    char key = read keyInput;
    switch(key) {
		case '4':
			px = px - 10;
			call update;
		case '6':
			px = px + 10;
			call update;
		case '2':
			py = py - 10;
			call update;
		case '8':
			py = py + 10;
			call update;
		case '#':
			load("main");
	}
    delay 0.01;
}